{
  "name": "claude-harness",
  "version": "0.4.1",
  "private": true,
  "description": "Multi-host tmux desktop app for Claude Code sessions",
  "main": "./out/main/index.js",
  "author": "jgulick48",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "package": "electron-vite build && electron-builder --dir --publish never",
    "dist": "electron-vite build && electron-builder --publish never",
    "release": "electron-vite build && electron-builder --publish always",
    "test:e2e": "npm run test:e2e:renderer && npm run test:e2e:electron",
    "test:e2e:renderer": "playwright test -c e2e/playwright.config.ts --project renderer --project renderer-dark",
    "test:e2e:electron": "playwright test -c e2e/playwright.config.ts --project electron"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "6.8.11",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
